# Copy to .env and fill in.
DATABASE_URL="postgresql://tierup:tierup@localhost:5433/tierup"
DIRECT_URL="postgresql://tierup:tierup@localhost:5433/tierup"

# Auth.js (Phase 2)
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Meet provider: "fake" (local dev/tests; links look real but don't open a meeting) or "google".
# "google" needs a Google Workspace account that owns the events: a service account with
# domain-wide delegation (scopes: calendar.events, meetings.space.created) impersonating the organizer.
MEET_PROVIDER="fake"
GOOGLE_MEET_SERVICE_ACCOUNT=""  # keyless on Cloud Run: the Meet service account email (see DEPLOY.md §10)
GOOGLE_SERVICE_ACCOUNT_KEY=""   # or, outside GCP: base64 of the service account JSON key
GOOGLE_MEET_ORGANIZER=""        # Workspace user that owns the events, e.g. sessions@yourdomain.org
GOOGLE_MEET_CALENDAR_ID=""      # optional; defaults to the organizer's primary calendar

# Email (Phase 2/9): leave RESEND_API_KEY empty to log emails to the console
RESEND_API_KEY=""
EMAIL_FROM="TierUp <noreply@tierup.app>"
APP_URL="http://localhost:3000"

# Show the seeded demo schools in production builds (previews / e2e only)
ALLOW_DEMO_SCHOOLS="false"

# AI session summaries (topics covered + practice next), emailed to the learner and tutor after a
# session. "claude" uses the Claude API (needs ANTHROPIC_API_KEY), "fake" writes placeholder
# summaries offline (dev), unset turns them off.
AI_SUMMARIES=""
ANTHROPIC_API_KEY=""

# Cross-school tutoring: "true" lets learners meet tutors from other schools (online only).
# Off by default: learners only see and book tutors at their own school.
CROSS_SCHOOL_SESSIONS="false"

# Session transcripts for AI summaries (only when both students opt in and they're at the same school).
# "on" turns them on. Schools with Google Workspace for Education (Education Plus or the Teaching and
# Learning Upgrade) are listed in GOOGLE_EDUCATION_SCHOOLS as staffdomain=organizer@thatdomain: their
# online sessions are hosted in their own Workspace and Meet writes the transcript. Every other session
# uses TierUp's mic capture plus speech-to-text (TRANSCRIPT_STT="google" for Google Cloud Speech-to-Text,
# anything else uses an offline fake for dev).
TRANSCRIPTS="off"
GOOGLE_EDUCATION_SCHOOLS=""
TRANSCRIPT_STT=""
GOOGLE_CLOUD_PROJECT=""   # Speech-to-Text project (defaults to the runtime's project on Cloud Run)
STT_LOCATION="us"
STT_MODEL="chirp_3"
# After 30 days transcripts are deleted; with TRANSCRIPT_ARCHIVE set, a de-identified copy is kept
# first: "gs://bucket/prefix" (production) or "file:./.data/archive" (dev). ARCHIVE_SALT: 32+ random
# characters, secret, never changed (it makes the one-way student codes).
TRANSCRIPT_ARCHIVE=""
ARCHIVE_SALT=""

# TierUp platform admins (comma-separated). They get /admin: schools, staff domains, waitlist.
ADMIN_EMAILS=""

# Parent consent step, banners, parent emails and consent checks. Off for now: only teacher
# approval gates tutoring. Set to "true" to bring it back.
PARENT_CONSENT="false"

# Days after a tutor-approval request becomes approvable before the endorsing teacher gets one
# reminder email. 0 turns reminders off.
TUTOR_APPROVAL_REMINDER_DAYS="3"

# Protects /api/cron/*. Generate with: openssl rand -hex 24
CRON_SECRET=""

# ── Production / preview switches ──
# Previews only: print emails to the log instead of sending (never in real production).
ALLOW_CONSOLE_EMAIL="false"
# Previews only: fake Meet links instead of Google.
ALLOW_FAKE_MEET="false"
# TESTING ONLY: skip staff email-domain checks (any email can be an endorsing teacher or staff).
# The app refuses to start in production with this on.
RELAX_STAFF_DOMAINS="false"
# Allow `npm run db:seed` (wipes data!) against a non-local throwaway database.
ALLOW_DEMO_SEED="false"
